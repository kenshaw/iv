# the patterns above are for stray output, not for fixtures: testdata holds
# png, ico, ttf, xps, txt, xml and html files that are all meant to be tracked
!/testdata/**

# the linter configuration, which *.yml would otherwise ignore
!/.golangci.yml

/.bash_profile
/.bashrc
# .claude holds the agent skills, which are tracked, and the state of one
# person, which is not. settings.local.json holds the claude code permissions
# of one person
/.claude/*
!/.claude/skills/
.claude/settings.local.json
